generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailAccount {
  id       Int     @id @default(autoincrement())
  empId    String?
  email    String  @unique
  provider String? // gmail, outlook, zoho, generic

  // IMAP Settings
  imapHost   String?
  imapPort   Int?
  imapUser   String?
  imapSecure Boolean? @default(true)

  // SMTP Settings
  smtpHost   String?
  smtpPort   Int?
  smtpUser   String?
  smtpSecure Boolean? @default(true)

  // Auth
  authType      String  @default("password") // password, oauth2
  encryptedPass String?

  // OAuth2 Tokens
  oauthClientId     String?
  oauthClientSecret String?
  refreshToken      String?
  accessToken       String?
  tokenExpiry       DateTime?

  // Gmail Push
  watchExpiry DateTime?
  historyId   String?

  // Sync State
  verified       Boolean   @default(true)
  lastFullSyncAt DateTime?
  lastSyncAt     DateTime?
  syncStatus     String?   @default("idle")
  syncError      String?

  // Signature
  signature String?

  senderName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages          EmailMessage[]
  scheduledMessages ScheduledMessage[]
  syncStates        SyncState[]
  folders           EmailFolder[]
  Conversation      Conversation[]
  groupId           Int?
  group             EmailAccountGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // ── Soft-delete + background permanent-delete tracking ──
  deleted                   Boolean   @default(false)
  deleteStatus              String? // "DELETING" | "FAILED" | null
  deleteStartedAt           DateTime?
  deleteCompletedAt         DateTime?
  totalEmails               Int?      @default(0)
  deletedEmails             Int?      @default(0)
  deleteProgress            Int?      @default(0)
  estimatedDeleteAt         DateTime?
  estimatedSecondsRemaining Int?

  // ── Sending health (Phase 1) ──
  // Set automatically when the account's bounce rate spikes or the
  // provider reports a sending-quota error; cleared by an admin (or
  // automatically after ACCOUNT_PAUSE_HOURS). While set, the campaign
  // engine does not send from this account.
  sendingPausedAt     DateTime?
  sendingPausedReason String?
  sendingPausedUntil  DateTime?

  // ── Daily cap & warm-up (Phase 4) ──
  /// Manual cap for this mailbox (emails per day). Overrides warm-up and
  /// the company default when set.
  dailyCap       Int?
  /// Gradually raise this mailbox's cap from warmupStartCap to warmupTarget.
  warmupEnabled  Boolean   @default(false)
  warmupStartAt  DateTime?
  warmupStartCap Int?
  warmupTarget   Int?

  @@index([userId])
  @@index([email])
}

model EmailAccountGroup {
  id        Int      @id @default(autoincrement())
  name      String
  color     String   @default("#10b981")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts EmailAccount[]

  @@index([userId])
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  empId    String? @unique
  name     String?
  jobRole  String  @default("EMP")
  location String?
  isActive Boolean @default(true) // ✅ Active/Inactive status

  // Set when an admin changes/resets the password. Login tokens issued
  // before this moment are rejected, so a reset logs out old sessions.
  passwordChangedAt DateTime?

  // ── CRM (Phase 2) ──
  ownedContacts   Contact[]      @relation("ContactOwner")
  ownedCompanies  Company[]      @relation("CompanyOwner")
  ownedDeals      Deal[]         @relation("DealOwner")
  assignedTasks   Task[]         @relation("TaskAssignee")
  createdTasks    Task[]         @relation("TaskCreator")
  crmActivities   Activity[]     @relation("ActivityUser")
  notifications   Notification[]
  ownedSequences  FollowupSequence[] @relation("SequenceOwner")

  emailAccounts      EmailAccount[]
  ScheduledMessage   ScheduledMessage[]
  Tag                Tag[]
  Lead               Lead[]
  emailAccountGroups EmailAccountGroup[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  Campaign           Campaign[]
}

model Conversation {
  id             String @id
  emailAccountId Int

  subject        String?
  participants   String?
  toRecipients   String?
  ccRecipients   String?
  initiatorEmail String?
  lastMessageAt  DateTime?
  messageCount   Int       @default(0)
  unreadCount    Int       @default(0)
  isStarred      Boolean   @default(false)

  account         EmailAccount       @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  messages        EmailMessage[]
  scheduled       ScheduledMessage[]
  ConversationTag ConversationTag[]

  @@index([emailAccountId, lastMessageAt])
}

model EmailMessage {
  id             Int     @id @default(autoincrement())
  emailAccountId Int
  conversationId String?

  messageId String?
  fromEmail String
  fromName  String?
  toEmail   String?
  ccEmail   String?
  subject   String?
  body      String?
  direction String
  folder    String?

  isRead    Boolean @default(false)
  isStarred Boolean @default(false)

  isSpam    Boolean @default(false)
  isTrash   Boolean @default(false)
  hideTrash Boolean @default(false)
  hideInbox Boolean @default(false)

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  // ✅ FIXED HERE
  account EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  conversation Conversation? @relation(fields: [conversationId], references: [id])

  attachments Attachment[]
  MessageTag  MessageTag[]

  @@unique([emailAccountId, messageId])
  @@index([emailAccountId, conversationId])
  @@index([emailAccountId, sentAt])
  // ── Inbox performance + 7-day retention ──
  // Retention purge: "createdAt < now - 7 days" (each email's own clock)
  @@index([createdAt])
  // Folder list: one account + folder, newest first
  @@index([emailAccountId, folder, sentAt])
  // Sidebar unread badges (POST /api/inbox/accounts/unread-bulk)
  @@index([emailAccountId, folder, direction, isRead])
  // Opening a thread (GET /conversations/:id/messages) filters by
  // conversationId alone, which the composite index above can't serve
  @@index([conversationId, sentAt])
  // Follow-up threading lookup (one query per follow-up email):
  //   WHERE emailAccountId = ? AND toEmail = ? ORDER BY sentAt ASC
  @@index([emailAccountId, toEmail, sentAt])
}

model Attachment {
  id             Int          @id @default(autoincrement())
  emailMessageId Int
  filename       String? // ✅ MAKE OPTIONAL
  mimeType       String?
  size           Int?
  storageUrl     String?
  hash           String?
  message        EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
}

model ScheduledMessage {
  id Int @id @default(autoincrement())

  accountId      Int?
  conversationId String?

  toEmail  String
  ccEmail  String?
  subject  String?
  bodyHtml String?
  sendAt   DateTime

  leadStatus   String?
  status       String  @default("pending") // pending | sent
  isFollowedUp Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  EmailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  emailAccountId Int?
  Conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([emailAccountId])
  // Due-message polling: WHERE status = 'pending' AND sendAt <= now
  @@index([status, sendAt])
  @@index([userId])
}

model SyncState {
  id        Int      @id @default(autoincrement())
  accountId Int
  folder    String
  lastUid   Int?
  updatedAt DateTime @updatedAt

  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // IMAP sync reads/writes lastUid by (accountId, folder) for every folder
  // of every account, every tick.
  @@index([accountId, folder])
}

model EmailFolder {
  id        Int    @id @default(autoincrement())
  accountId Int
  name      String

  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model CustomStatus {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}

model CustomLeadStatus {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  color       String   @default("bg-gray-100 text-gray-800 border-gray-200")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        Int      @id @default(autoincrement())
  userId    String
  empId     String?
  name      String
  color     String?
  createdAt DateTime @default(now())

  conversationTags ConversationTag[]
  messageTags      MessageTag[]
  user             User              @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ConversationTag {
  conversationId String
  tagId          Int
  userId         String
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model MessageTag {
  messageId Int
  tagId     Int
  userId    String
  Message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  Tag       Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([messageId, tagId])
}

model Campaign {
  id             Int    @id @default(autoincrement())
  name           String
  userId         String
  emailAccountId Int?

  subject          String?
  fromAccountIds   String?
  pitchIds         String?
  bodyHtml         String
  originalBodyHtml String?
  senderRole       String?

  // 🔹 STATUS & TYPE
  status String @default("draft")
  // draft | sending | completed | scheduled | paused

  sendType String
  // immediate | scheduled

  scheduledAt DateTime?
  createdAt   DateTime  @default(now())

  estimatedCompletion DateTime?

  // 🔹 Self-relation (parent → child campaigns)
  parentCampaignId Int?
  parentCampaign   Campaign?  @relation("CampaignHierarchy", fields: [parentCampaignId], references: [id])
  childCampaigns   Campaign[] @relation("CampaignHierarchy")

  // 🔹 Batch sending fields
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  batchSize       Int? // 50 / 80 / 100
  batchDelayMins  Int? // 120 mins (2 hr)
  nextRunAt       DateTime?
  lastSentAt      DateTime?
  customLimits    String?

  error String?

  // 🔹 Follow-up automation (Phase 3): set on campaigns a sequence creates.
  sequenceId   Int?
  sequence     FollowupSequence? @relation("SequenceCampaigns", fields: [sequenceId], references: [id], onDelete: SetNull)
  sequenceStep Int?
  // The sequence whose base (root) campaign this is.
  rootOfSequence FollowupSequence? @relation("SequenceRoot")

  // 🔹 Relation
  recipients CampaignRecipient[]
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
  // ── Performance indexes ──
  // Worker resume tick + locked-account checks: WHERE status = 'sending'
  @@index([status])
  // Scheduler: WHERE status = 'scheduled' AND scheduledAt <= now
  @@index([status, scheduledAt])
  // Campaign list / dashboard: WHERE userId = ? ORDER BY createdAt DESC
  @@index([userId, createdAt])
  // Follow-up chain lookups + cleanup job
  @@index([parentCampaignId])
  @@index([sendType, status])
  @@index([sequenceId])
}

model CampaignRecipient {
  id            Int       @id @default(autoincrement())
  campaignId    Int
  email         String
  status        String    @default("pending")
  error         String?
  sentAt        DateTime?
  accountId     Int?
  sentSubject   String?
  sentBodyHtml  String?
  sentFromEmail String?
  retryCount    Int       @default(0)
  sendingIp     String?
  lastTriedAt   DateTime?
  updatedAt     DateTime?

  // ── Engagement (Phase 1) ──
  // status stays "sent" for these; the timestamps record what happened next.
  repliedAt      DateTime?
  bouncedAt      DateTime?
  bounceType     String? // "hard" | "soft" | "block"
  unsubscribedAt DateTime?

  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([status, sentAt])
  // Sender loop: per-batch count + fetch
  //   WHERE campaignId = ? AND accountId = ? AND status = 'pending' ORDER BY id
  // Also serves the progress groupBy (campaignId, accountId, status).
  @@index([campaignId, accountId, status, id])
  // Stuck-email recovery sweep (every 2 min):
  //   WHERE status = 'processing' AND updatedAt < ?
  @@index([status, updatedAt])
  // Busy-account lookup (accountId prefix) and per-account health:
  //   WHERE accountId = ? AND sentAt >= ?
  @@index([accountId, sentAt])
  // Reply matching by address + follow-up exclusion:
  //   WHERE email = ? AND sentAt BETWEEN ? AND ?
  @@index([email, sentAt])
  // NOTE: the old @@index([campaignId]) was removed — it is a prefix of
  // @@unique([campaignId, email]) and @@index([campaignId, status]), so it
  // only cost write time on every insert/update.
}

model PitchTemplate {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String
  subject   String?
  bodyHtml  String
  type      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Lead {
  id Int @id @default(autoincrement())

  // ===== Core Identity =====
  email   String // Lead Email (CAN BE DUPLICATE)
  name    String?
  subject String?

  // ===== Lead Classification =====
  leadType       LeadType?
  attendeesCount Int?      @default(0)

  // ===== Contact Info =====
  fromName  String?
  fromEmail String? @unique // ✅ Client Email (MUST BE UNIQUE)
  toEmail   String?
  ccEmail   String?
  bccEmail  String?

  phone       String?
  country     String?
  website     String?
  leadLink    String?
  contactDate DateTime?

  // ===== Email Content =====
  emailPitch String? @db.Text

  // ===== Conversation Tracking =====
  conversationId String?
  totalMessages  Int     @default(0)
  thread         Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ===== CRM (Phase 2) =====
  // The shared CRM contact this lead belongs to (set on creation and by
  // scripts/migrateLeadsToCrm.js).
  contactId Int?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // ===== System =====
  sentAt     DateTime?
  headerText String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([email])
  @@index([contactId])
}

enum LeadType {
  ASSOCIATION
  ATTENDEES
  INDUSTRY
}

model DailyEmailLog {
  id Int @id @default(autoincrement())

  userName String
  empId    String

  count Int

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  userId    String

  // The unique constraint already creates a (userId, sentAt) index; the old
  // duplicate @@index was removed because every send updates this row.
  @@unique([userId, sentAt])
  @@index([sentAt])
}


// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1 — REPLIES, BOUNCES, SUPPRESSION
// These tables intentionally have no foreign keys: events must survive
// campaign clean-up and account deletion (they are the audit trail for
// "why did we stop emailing this person?").
// ═══════════════════════════════════════════════════════════════════════════

/// Company-wide do-not-contact list. Checked before every campaign send.
model SuppressedEmail {
  id         Int      @id @default(autoincrement())
  email      String   @unique // always lower-case
  /// unsubscribe | reply_request | hard_bounce | soft_bounce | manual | import
  reason     String
  /// link | one_click | mailto | reply | bounce | admin | import
  source     String?
  note       String?
  campaignId Int?
  accountId  Int?
  addedById  String?
  createdAt  DateTime @default(now())

  @@index([reason, createdAt])
  @@index([createdAt])
}

/// One row per bounce notification found in a mailbox.
model EmailBounce {
  id          Int      @id @default(autoincrement())
  email       String
  accountId   Int
  campaignId  Int?
  recipientId Int?
  /// hard (address is bad) | soft (temporary) | block (rejected as spam/policy)
  type        String
  statusCode  String?
  diagnostic  String?
  /// Message-ID of the bounce notification itself — makes processing idempotent.
  messageId   String
  createdAt   DateTime @default(now())

  @@unique([accountId, messageId])
  @@index([email, createdAt])
  @@index([accountId, createdAt])
}

/// One row per human reply to a campaign email.
model ReplyEvent {
  id             Int       @id @default(autoincrement())
  /// The address we emailed (lower-case), even if they replied from an alias.
  email          String
  fromEmail      String?
  accountId      Int
  campaignId     Int?
  recipientId    Int?
  messageId      String
  conversationId String?
  subject        String?
  snippet        String?
  /// reply | unsubscribe_request
  intent         String    @default("reply")
  /// header (matched by Message-ID) | address (matched by sender address)
  matchedBy      String
  receivedAt     DateTime
  /// Only for intent = unsubscribe_request: pending | suppressed | dismissed
  reviewStatus   String?
  reviewedAt     DateTime?
  reviewedById   String?

  // ── Classification (Phase 3) ──
  /// interested | meeting | question | not_interested | wrong_person | unsubscribe | other
  category       String?
  /// rules | ai | manual
  categorySource String?
  confidence     Float?
  /// Triage in the Replies screen
  handledAt      DateTime?
  handledById    String?

  createdAt      DateTime  @default(now())

  @@unique([accountId, messageId])
  @@index([category, receivedAt])
  @@index([handledAt, receivedAt])
  @@index([email, receivedAt])
  @@index([accountId, receivedAt])
  @@index([reviewStatus, createdAt])
  @@index([campaignId])
}


// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2 — CRM: companies, contacts, deals, pipeline, activities, tasks
//
// Sharing model: one Contact per email address company-wide, with one
// owner. Everyone can see CRM records; only the owner or Admin/HR can edit.
// ═══════════════════════════════════════════════════════════════════════════

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  /// Lower-case web domain (acme.com). Unique when set; free-mail domains are never stored.
  domain    String?  @unique
  website   String?
  industry  String?
  country   String?
  phone     String?
  size      String?
  notes     String?  @db.Text

  ownerId   String
  owner     User     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([ownerId, updatedAt])
}

model Contact {
  id        Int      @id @default(autoincrement())
  /// Always lower-case. One contact per address across the whole company.
  email     String   @unique
  firstName String?
  lastName  String?
  /// Display name ("First Last", or the name from the email header).
  name      String?
  phone     String?
  jobTitle  String?
  country   String?
  website   String?
  linkedin  String?
  /// association | attendees | industry (from the old LeadType) or free text
  category  String?
  /// lead | prospect | customer | lost
  lifecycle String   @default("lead")
  /// lead | reply | manual | import | campaign
  source    String   @default("manual")
  tags      String[] @default([])

  ownerId   String
  owner     User     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  lastActivityAt DateTime?
  createdById    String?

  deals      Deal[]
  tasks      Task[]
  activities Activity[]
  leads      Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([companyId])
  @@index([lastActivityAt])
  @@index([lifecycle, updatedAt])
}

model PipelineStage {
  id          Int      @id @default(autoincrement())
  name        String
  /// Display order (ascending)
  position    Int
  /// open | won | lost
  kind        String   @default("open")
  color       String   @default("#0ea5e9")
  /// Default win probability for forecasting (0–100)
  probability Int      @default(0)
  /// Stage new deals start in
  isDefault   Boolean  @default(false)
  archived    Boolean  @default(false)

  deals       Deal[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([archived, position])
}

model Deal {
  id              Int       @id @default(autoincrement())
  title           String
  amount          Decimal?  @db.Decimal(14, 2)
  currency        String    @default("USD")
  /// open | won | lost (mirrors the stage kind)
  status          String    @default("open")
  expectedCloseAt DateTime?
  closedAt        DateTime?
  lostReason      String?
  /// Order inside a pipeline column
  position        Float     @default(0)
  source          String?
  /// Idempotency key for automated creation (e.g. "lead:123")
  externalKey     String?   @unique

  stageId   Int
  stage     PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  contactId Int?
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  companyId Int?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  ownerId   String
  owner     User      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  tasks      Task[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId, position])
  @@index([ownerId, status])
  @@index([contactId])
  @@index([companyId])
  @@index([status, updatedAt])
}

/// Manual and system events on the timeline. Campaign emails, replies and
/// bounces are NOT copied here — the timeline reads them from their own
/// tables, so there is one source of truth.
model Activity {
  id          Int       @id @default(autoincrement())
  /// note | call | meeting | email | stage_change | status_change |
  /// task_completed | created | lead_created | owner_change
  type        String
  title       String?
  body        String?   @db.Text
  meta        Json?
  occurredAt  DateTime  @default(now())
  /// Idempotency key for automated entries (e.g. "lead:123")
  externalKey String?   @unique

  contactId Int?
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    Int?
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  companyId Int?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?     @relation("ActivityUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())

  @@index([contactId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([companyId, occurredAt])
}

model Task {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?   @db.Text
  dueAt          DateTime?
  remindAt       DateTime?
  reminderSentAt DateTime?
  /// open | done
  status         String    @default("open")
  /// low | normal | high
  priority       String    @default("normal")
  completedAt    DateTime?
  /// Idempotency key for automated tasks (e.g. "reply:123")
  externalKey    String?   @unique

  contactId Int?
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    Int?
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId, status, dueAt])
  @@index([contactId])
  @@index([dealId])
  @@index([status, remindAt])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// task_reminder | task_assigned | deal_assigned | contact_assigned
  type      String
  title     String
  body      String?
  /// In-app path to open, e.g. /crm/tasks
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}


// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3 — AUTOMATION: settings, follow-up sequences
// ═══════════════════════════════════════════════════════════════════════════

/// Company-wide settings stored as JSON (e.g. "replyAutomation").
model CrmSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Automatic follow-ups for one base campaign:
/// "no reply after N days → send step 1, then step 2 …", stopping for
/// anyone who replies, bounces or unsubscribes.
model FollowupSequence {
  id         Int      @id @default(autoincrement())
  name       String
  /// The base (root) campaign. One sequence per campaign.
  campaignId Int      @unique
  campaign   Campaign @relation("SequenceRoot", fields: [campaignId], references: [id], onDelete: Cascade)
  /// draft | active | paused | archived
  status     String   @default("draft")

  ownerId    String
  owner      User     @relation("SequenceOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
  campaigns   Campaign[] @relation("SequenceCampaigns")

  activatedAt DateTime?
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model SequenceStep {
  id         Int              @id @default(autoincrement())
  sequenceId Int
  sequence   FollowupSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  /// 1-based order
  position   Int
  /// Wait this long after the previous email to this person
  delayDays  Int
  bodyHtml   String           @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([sequenceId, position])
}

/// One person's progress through a sequence.
model SequenceEnrollment {
  id              Int              @id @default(autoincrement())
  sequenceId      Int
  sequence        FollowupSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  /// Lower-case address
  email           String
  /// The base-campaign recipient row
  rootRecipientId Int
  /// Mailbox that sent the original (follow-ups go from the same one)
  accountId       Int
  /// How many steps have been queued for this person
  stepsSent       Int              @default(0)
  nextDueAt       DateTime?
  /// active | replied | bounced | unsubscribed | completed | stopped
  status          String           @default("active")
  stoppedReason   String?
  lastCampaignId  Int?
  lastStepAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([sequenceId, email])
  @@index([sequenceId, status, nextDueAt])
  @@index([status, nextDueAt])
}


// ═══════════════════════════════════════════════════════════════════════════
// PHASE 4 — per-mailbox daily send counters
// One row per mailbox per sending day (the 5 PM → 5 PM window the engine
// already uses). Written by the sender, read for caps and the dashboard.
// ═══════════════════════════════════════════════════════════════════════════

model AccountDailySend {
  id        Int      @id @default(autoincrement())
  accountId Int
  /// Start of the sending day this count belongs to
  day       DateTime
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([accountId, day])
  @@index([day])
}
