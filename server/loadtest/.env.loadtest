# Load-test environment — used with:  node --env-file=loadtest/.env.loadtest <script>
# Never put a production DATABASE_URL here.

DATABASE_URL=postgresql://loadtest:loadtest@localhost:5433/abacco_loadtest
JWT_SECRET=loadtest-secret-not-for-production
PORT=5050
NODE_ENV=production
CORS_ORIGINS=http://localhost:5173

# Lift the business daily cap so the test measures the system, not the rule.
DAILY_SEND_LIMIT=10000000

# Same defaults as production; change these between runs to find the limit.
ACCOUNT_CONCURRENCY=12
PRISMA_POOL_SIZE=14

# Fake SMTP server (Mailpit)
LT_SMTP_HOST=localhost
LT_SMTP_PORT=1025
LT_MAILPIT_API=http://localhost:8025

# API base for the scripts
LT_API=http://localhost:5050
